  "sql": "BEGIN READ ONLY;\nSET LOCAL statement_timeout = '60s';\nCOPY (\n SELECT now() AS extraction_utc,id AS content_item_id,platform,external_id,content_type,canonical_url,creator_handle,published_at,updated_at AS snapshot_at,title,primary_text,views,likes,comments,shares,saves,is_ad,payload->>'is_ad' AS payload_is_ad,payload->>'is_paid_partnership' AS paid_partnership,payload->>'duration_ms' AS duration_ms\n FROM conthunt.content_items\n WHERE platform IN ('tiktok','instagram','youtube')\n AND ((platform='tiktok' AND content_type='video' AND canonical_url ~* '^https?://(www\\.|m\\.|vm\\.)?tiktok\\.com/') OR (platform='instagram' AND content_type IN ('reel','video') AND canonical_url ~* '^https?://(www\\.)?instagram\\.com/(reel|reels)/') OR (platform='youtube' AND content_type='short' AND canonical_url ~* '^https?://(www\\.|m\\.)?youtube\\.com/shorts/'))\n AND external_id IS NOT NULL AND external_id <> '' AND published_at >= '2026-01-01 00:00:00+00' AND published_at <= now()\n) TO STDOUT WITH (FORMAT CSV, HEADER TRUE);\nROLLBACK;\n",
  "rules": {
    "scope_limitation": "Canonical URLs on supported platform domains and recorded short-form types are a public-content proxy; individual current public accessibility or source visibility was not verified. Captions and metrics are cached database values.",
    "window": "2026-01-01 00:00:00 UTC <= published_at <= extraction timestamp minus 7 days",
    "dedup": "By platform and external_id; keep lexicographically greatest snapshot_at then content_item_id.",
    "niche": "Case-insensitive Python regex on title plus the first 400 characters of primary_text; first match by listed insertion order, overlap counted. Tech career/salary posts without AI/tool/app/iPhone/laptop/gadget/automation/agent/coding are excluded from tech. Ecommerce candidates mentioning TikTok Shop also require one of product/find/finds/haul/buy/unbox/purchase/order/review/dupe/shop finds in the same text.",
    "niche_regexes": {
      "beauty-skincare": "\\b(?:skincare|makeup|sunscreen|retinol|serum|cleanser|moisturizer|lip gloss|foundation|concealer|acne|dermatolog\\w*|blush|mascara)\\b",
      "ecommerce-product-finds": "\\b(?:tiktok shop|amazon find\\w*|amazon must have|unboxing|product review|haul|worth the hype|dupe|best buy|gadget find\\w*|small business packaging)\\b",
      "fitness-wellness": "\\b(?:workout|gym|protein|fat loss|muscle|pilates|running|calisthenics|hypertrophy|cardio|strength training|nutrition|macro\\w*|creatine)\\b",
