<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <% const resolvedTitle = (typeof seoTitle !== 'undefined' && seoTitle) ? seoTitle : pageTitle; -%>
    <title><%= resolvedTitle %></title>
    <meta name="title" content="<%= resolvedTitle %>" />
    <meta name="description"
        content="<%= description || 'Insights, tutorials, and updates from the ContHunt team.' %>" />
    <% if (Array.isArray(resolvedKeywords) && resolvedKeywords.length> 0) { %>
        <meta name="keywords" content="<%= resolvedKeywords.join(', ') %>" />
        <% } %>

    <% const resolvedWebPageType = (typeof webPageType !== 'undefined' && webPageType) ? webPageType : 'WebPage'; -%>
    <% const resolvedCanonical = (typeof canonical !== 'undefined' && canonical) ? canonical : 'https://conthunt.app/'; -%>
    <%
      const organizationSchema = {
        "@type": "Organization",
        "@id": "https://conthunt.app/#organization",
        "name": "ContHunt",
        "legalName": "Synthenova Enterprises LLP",
        "url": "https://conthunt.app",
        "logo": "https://conthunt.app/public/logo-title-white.png",
        "email": "support@conthunt.app",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Chennai",
          "addressCountry": "IN"
        },
        "sameAs": [
          "https://x.com/conthunt",
          "https://instagram.com/conthunt.app",
          "https://tiktok.com/@conthunt.app"
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer service",
          "email": "support@conthunt.app"
        }
      };
      const graph = [
        organizationSchema,
        { "@type": "WebSite", "name": "ContHunt", "url": "https://conthunt.app/", "publisher": { "@id": "https://conthunt.app/#organization" } },
        {
          "@type": resolvedWebPageType === 'WebPage' ? 'WebPage' : [resolvedWebPageType, 'WebPage'],
          "name": resolvedTitle,
          "url": resolvedCanonical,
          "isPartOf": { "@type": "WebSite", "name": "ContHunt", "url": "https://conthunt.app/" },
          "description": description || '',
          ...(typeof updated !== 'undefined' && updated ? { "dateModified": updated } : {})
        }
      ];
      if (typeof personSchema !== 'undefined' && personSchema && personSchema.name) {
        graph.push({
          "@type": "Person",
          "name": personSchema.name,
          ...(personSchema.url ? { "url": personSchema.url } : {}),
          ...(personSchema.image ? { "image": personSchema.image } : {}),
          ...(personSchema.jobTitle ? { "jobTitle": personSchema.jobTitle } : {}),
          ...(personSchema.description ? { "description": personSchema.description } : {}),
          "worksFor": { "@id": "https://conthunt.app/#organization" }
        });
      }
      if (Array.isArray(typeof collectionItems !== 'undefined' ? collectionItems : null) && collectionItems.length > 0) {
        graph.push({
          "@type": "ItemList",
          "name": resolvedTitle,
          "itemListElement": collectionItems.map(item => ({
            "@type": "ListItem",
            "position": item.position,
            "name": item.name,
            "url": item.url
          }))
        });
        graph.push({
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://conthunt.app" },
            { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://conthunt.app/blog" }
          ]
        });
      }
    %>

            <% const heroAbs=hero ? (hero.startsWith('http') ? hero : `https://conthunt.app${hero}`) : null; %>
                <% const hasAuthorObject=typeof author !== 'undefined' && author && typeof author === 'object' && author.name; %>
                    <% const hasAuthorProfile=typeof authorProfile !=='undefined' && authorProfile && authorProfile.name; %>
                    <% const authorSchema=hasAuthorObject ? { "@type" : "Person" , "name" : author.name,
                        ...(author.url ? { "url" : author.url.startsWith('http') ? author.url : `https://conthunt.app${author.url}` } : {}),
                        ...(author.image ? { "image" : author.image.startsWith('http') ? author.image : `https://conthunt.app${author.image}` } : {}),
                        ...(author.same_as ? { "sameAs" : author.same_as } : {}),
                        ...(author.role ? { "jobTitle" : author.role } : {}),
                        ...(author.bio ? { "description" : author.bio } : {}) } : hasAuthorProfile ? { "@type" : "Person" , "name" : authorProfile.name,
                        ...(authorProfile.urlAbs ? { "url" : authorProfile.urlAbs } : (authorProfile.url ? { "url" :
                        authorProfile.url } : {})), ...(authorProfile.imageAbs ? { "image" : authorProfile.imageAbs } :
                        (authorProfile.image ? { "image" : authorProfile.image } : {})), ...(authorProfile.same_as ?
                        { "sameAs" : authorProfile.same_as } : {}), ...(authorProfile.job_title ? { "jobTitle" :
                        authorProfile.job_title } : {}), ...(authorProfile.description ? { "description" :
                        authorProfile.description } : {}) } : { "@type" : "Person" , "name" : (typeof author
                        !=='undefined' ) ? author : "ContHunt Team" }; %>

                        <% if (typeof isBlogPost !=='undefined' && isBlogPost) {
                            graph.push({
                                "@type": "Article",
                                "headline": pageTitle,
                                "description": description || '',
                                "image": heroAbs || 'https://conthunt.app/public/banner.png',
                                "datePublished": (typeof date !== 'undefined') ? date : '',
                                "dateModified": (typeof updated !== 'undefined') ? updated : (typeof date !== 'undefined' ? date : ''),
                                "author": authorSchema,
                                "publisher": { "@id": "https://conthunt.app/#organization" },
                                "mainEntityOfPage": {
                                    "@type": "WebPage",
                                    "@id": canonical
                                }
                            });
                            graph.push({
                                "@type": "BreadcrumbList",
                                "itemListElement": [
                                    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://conthunt.app" },
                                    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://conthunt.app/blog" },
                                    { "@type": "ListItem", "position": 3, "name": pageTitle, "item": canonical }
                                ]
                            });
                        } %>
                            <script type="application/ld+json">
<%- JSON.stringify({ "@context": "https://schema.org", "@graph": graph }, null, 2) %>
    </script>

                                <% if (typeof isHomepage !=='undefined' && isHomepage) { %>
                                    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "ContHunt",
        "url": "https://conthunt.app",
        "logo": "https://conthunt.app/public/logo-title-white.png",
        "sameAs": [
            "https://x.com/conthunt",
            "https://instagram.com/conthunt.app",
            "https://tiktok.com/@conthunt.app"
        ],
        "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "customer service",
            "email": "support@conthunt.app"
        }
    }
    </script>
                                    <% if (heroAbs) { %>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ImageObject",
        "url": <%- JSON.stringify(heroAbs) %>,
        "contentUrl": <%- JSON.stringify(heroAbs) %>,
        "caption": <%- JSON.stringify(pageTitle) %>
    }
    </script>
                                        <% } %>
                                            <% } %>

                                                        <!-- Favicon -->
                                                        <link rel="icon" type="image/png" href="/public/favicon.png" />
                                                        <link rel="icon" type="image/png" sizes="192x192"
                                                            href="/public/favicon.png" />
                                                        <link rel="apple-touch-icon" href="/public/favicon.png" />

                                                        <!-- Open Graph -->
                                                        <meta property="og:type" content="<%= typeof ogType !== 'undefined' && ogType ? ogType : 'website' %>" />
                                                        <meta property="og:title" content="<%= pageTitle %>" />
                                                        <meta property="og:description" content="<%= description %>" />
                                                        <% if (heroAbs) { %>
                                                            <meta property="og:image" content="<%= heroAbs %>" />
                                                            <% } else { %>
                                                                <meta property="og:image"
                                                                    content="https://conthunt.app/public/banner.png" />
                                                                <% } %>
                                                                    <meta property="og:site_name" content="ContHunt" />
                                                                    <% if (typeof canonical !=='undefined' && canonical)
                                                                        { %>
                                                                        <meta property="og:url"
                                                                            content="<%= canonical %>" />
                                                                        <% } %>

                                                                            <!-- Twitter -->
                                                                            <meta name="twitter:card"
                                                                                content="summary_large_image" />
                                                                            <meta name="twitter:title"
                                                                                content="<%= pageTitle %>" />
                                                                            <meta name="twitter:description"
                                                                                content="<%= description %>" />
                                                                            <% if (heroAbs) { %>
                                                                                <meta name="twitter:image"
                                                                                    content="<%= heroAbs %>" />
                                                                                <% } else { %>
                                                                                    <meta name="twitter:image"
                                                                                        content="https://conthunt.app/public/banner.png" />
                                                                                    <% } %>

                                                                                        <meta name="robots"
                                                                                            content="index, follow" />
                                                                                        <meta name="theme-color"
                                                                                            content="#030303" />

                                                                                        <link rel="stylesheet"
                                                                                            href="/assets/css/tailwind.css?v=20260825e" />

                                                                                        <link rel="stylesheet"
                                                                                            href="/assets/css/style.css?v=20260825e" />
                                                                                        <link rel="stylesheet"
                                                                                            href="/assets/css/blog.css?v=20260825e" />
                                                                                        <style>
                                                                                          .dark-zone, #grid-torch { position: absolute !important; pointer-events: none; }
                                                                                          .glass-nav { position: relative !important; }
                                                                                        </style>

                                                                                        <% if (typeof canonical !=='undefined' && canonical) { -%>
                                                                                            <link href="<%= canonical %>" rel="canonical" />
                                                                                        <% } -%>
</head>

<body class="relative min-h-screen">
    <!-- Reading Progress Bar -->
    <div id="reading-progress"></div>

    <!-- Background Grid & Glows -->
    <div class="dark-zone" aria-hidden="true"></div>
    <div id="grid-torch" aria-hidden="true"></div>

    <!-- Navigation -->
    <nav
        class="relative z-50 glass-nav h-[65px] flex items-center justify-center transition-all duration-300 mx-auto max-w-[95%] md:max-w-[1000px] mt-4">
        <div class="w-full max-w-6xl px-6 flex items-center justify-between relative">
            <!-- Logo (left) -->
            <div class="flex items-center">
                <a href="/">
                    <img src="/public/logo-title-white.webp" alt="ContHunt Logo" width="462" height="78" class="h-6 w-auto" />
                </a>
            </div>

            <!-- Middle nav items -->
            <div class="hidden md:flex items-center gap-8 font-nav absolute left-1/2 -translate-x-1/2">
                <a href="/blog"
                    class="text-xs font-bold text-neutral-400 hover:text-white transition-colors">Resources</a>
                <a href="/#workflow"
                    class="text-xs font-bold text-neutral-400 hover:text-white transition-colors">Workflow</a>
                <a href="/#pricing"
                    class="text-xs font-bold text-neutral-400 hover:text-white transition-colors">Pricing</a>
            </div>

            <!-- Right side nav items -->
            <div class="flex items-center gap-4 font-nav">
                <a href="https://agent.conthunt.app" class="cta glass-button px-5 py-2 text-xs font-bold">
                    <span>LOGIN</span>
                    <span class="ml-1" aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </nav>

    <main class="relative z-10 pt-24 pb-20">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="bg-[#030303] pt-0 pb-20 text-sm z-20 relative">
        <div class="max-w-6xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-10">
            <div class="col-span-2">
                <div class="flex items-center gap-2 mb-4">
                    <img src="/public/faviconold.webp" alt="ContHunt Logo" width="128" height="128" loading="lazy" class="w-6 h-6">
                    <span class="font-semibold text-white">ContHunt</span>
                </div>
                <p class="text-neutral-500 max-w-xs mb-6">
                    The all-in-one content aggregation and research intelligence tool for the modern web.
                </p>
                <div class="flex gap-4">
                    <a href="https://x.com/conthunt" target="_blank"
                        class="text-neutral-500 hover:text-white">X</a>
                    <a href="https://instagram.com/conthunt.app" target="_blank"
                        class="text-neutral-500 hover:text-white">Instagram</a>
                    <a href="https://tiktok.com/@conthunt.app" target="_blank"
                        class="text-neutral-500 hover:text-white">TikTok</a>
                </div>
            </div>

            <div>
                <h4 class="text-white font-medium mb-4">Product.</h4>
                <ul class="space-y-2 text-neutral-500">
                    <li>
                        <a href="/blog" class="hover:text-white transition-colors">Resources</a>
                    </li>
                    <li>
                        <a href="/#workflow" class="hover:text-white transition-colors">Workflow</a>
                    </li>
                    <li>
                        <a href="/#pricing" class="hover:text-white transition-colors">Pricing</a>
                    </li>
                    <li>
                        <a href="/blog" class="hover:text-white transition-colors">Changelog</a>
                    </li>
                </ul>
            </div>

            <div>
                <h4 class="text-white font-medium mb-4">Company.</h4>
                <ul class="space-y-2 text-neutral-500">
                    <li>
                        <a href="/about" class="hover:text-white transition-colors">About</a>
                    </li>
                    <li>
                        <a href="/editorial" class="hover:text-white transition-colors">Editorial Standards</a>
                    </li>
                    <li>
                        <a href="/authors" class="hover:text-white transition-colors">Authors</a>
                    </li>
                </ul>
            </div>

            <div>
                <h4 class="text-white font-medium mb-4">Legal.</h4>
                <ul class="space-y-2 text-neutral-500">
                    <li>
                        <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
                    </li>
                    <li>
                        <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
                    </li>
                    <li>
                        <a href="mailto:support@conthunt.app" class="hover:text-white transition-colors">Contact</a>
                    </li>
                </ul>
            </div>
        </div>
        <div
            class="max-w-6xl mx-auto px-6 mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center text-neutral-600 text-xs">
            <p>© 2026 Synthenova Enterprises LLP, Chennai, India. All rights reserved. Contact <a href="mailto:support@conthunt.app" class="hover:text-white">support@conthunt.app</a>. <a href="https://www.indexnow.org/" class="hover:text-white">IndexNow</a></p>
            <div class="flex items-center gap-2 mt-4 md:mt-0">
                <span class="w-2 h-2 rounded-full bg-green-500"></span>
                <span>Systems Operational</span>
            </div>
        </div>
    </footer>

</body>

</html>
