<div class="blog-post">
    <div class="blog-post-header" style="max-width: none; text-align: left;">
        <p class="blog-post-toc-label">Resources</p>
        <h1>Blog</h1>
        <p class="blog-post-dek">Insights, tutorials, and updates from the ContHunt team.</p>
    </div>

    <div class="blog-grid">
        <% posts.forEach(post=> { %>
            <a href="/blog/<%= post.slug %>" class="blog-card-link">
                <h2 class="text-[1.35rem] leading-snug font-medium text-white mb-2"><%= post.title %></h2>
                <p class="text-[0.95rem] leading-6 text-neutral-400 mb-6"><%= post.description %></p>
                <span class="blog-post-toc-label" style="margin: 0;">
                    <%= new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </span>
            </a>
        <% }); %>
    </div>
</div>
