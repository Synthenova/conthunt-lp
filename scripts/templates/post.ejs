<%
  const tocSkip = /how should you apply|what should you write down|which conthunt workflow/i;
  const visibleToc = Array.isArray(tocItems)
    ? tocItems.filter(item => item.level === 2 && !tocSkip.test(item.title || '')).slice(0, 8)
    : [];
%>
<article class="blog-post">
    <header class="blog-post-header">
        <div class="blog-post-meta">
            <% if (author) { %>
                <span class="author">
                    <% if (author.url) { %><a rel="author" href="<%= author.url %>"><%= author.name %></a><% } else { %><%= author.name %><% } %>
                </span>
                <% if (author.role) { %>
                    <span class="blog-post-meta-muted"><%= author.role %></span>
                <% } %>
                <span aria-hidden="true">·</span>
            <% } else if (authorProfile && authorProfile.name) { %>
                <span class="author">
                    <% if (authorProfile.url) { %><a rel="author" href="<%= authorProfile.url %>"><%= authorProfile.name %></a><% } else { %><%= authorProfile.name %><% } %>
                </span>
                <span aria-hidden="true">·</span>
            <% } %>
            <time datetime="<%= date %>">
                <%= new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
            </time>
        </div>

        <h1><%= title %></h1>

        <% if (tags && tags.length > 0) { %>
            <div class="blog-post-tags">
                <% tags.slice(0, 4).forEach(tag => { %>
                    <span class="blog-tag"><%= tag %></span>
                <% }); %>
            </div>
        <% } %>
    </header>

    <% if (hero) { %>
        <figure class="blog-post-hero">
            <img src="<%= hero %>" alt="<%= title %>" width="1200" height="630" onerror="this.src='/public/banner.png';this.onerror=null;" />
        </figure>
    <% } %>

    <div class="blog-post-layout">
        <div class="blog-post-body prose-enhanced">
            <%- content %>

            <% if (Array.isArray(statItems) && statItems.length > 0) { %>
                <section class="blog-post-section">
                    <h2>Key data</h2>
                    <dl class="blog-stat-list">
                        <% statItems.forEach(stat => { %>
                            <div>
                                <dt><%= stat.label %></dt>
                                <dd><data value="<%= stat.value %>"><%= stat.value %></data>
                                    <% if (stat.context) { %><span> — <%= stat.context %></span><% } %>
                                </dd>
                            </div>
                        <% }); %>
                    </dl>
                </section>
            <% } %>

            <% if (Array.isArray(sourceItems) && sourceItems.length > 0) { %>
                <section class="blog-post-section">
                    <h2>Sources</h2>
                    <ol class="blog-source-list">
                        <% sourceItems.forEach(source => { %>
                            <li>
                                <a href="<%= source.url %>"><%= source.title %></a>
                                <% if (source.publisher) { %><span> · <%= source.publisher %></span><% } %>
                            </li>
                        <% }); %>
                    </ol>
                </section>
            <% } %>

            <% if (Array.isArray(faqSchemaItems) && faqSchemaItems.length > 0) { %>
                <section class="blog-post-section">
                    <h2>Questions</h2>
                    <% faqSchemaItems.forEach(item => { %>
                        <details class="blog-faq">
                            <summary><%= item.question.endsWith('?') ? item.question : item.question + '?' %></summary>
                            <p><%= item.answer %></p>
                        </details>
                    <% }); %>
                </section>
            <% } %>
        </div>

        <% if (visibleToc.length > 0) { %>
            <aside class="blog-post-toc" aria-label="On this page">
                <p class="blog-post-toc-label">On this page</p>
                <nav>
                    <ol>
                        <% visibleToc.forEach(item => { %>
                            <li><a href="#<%= item.id %>"><%= item.title %></a></li>
                        <% }); %>
                    </ol>
                </nav>
            </aside>
        <% } %>
    </div>

    <div class="blog-post-end">
        <a href="/blog" class="glass-button px-6 py-3 text-sm font-bold font-nav">All posts</a>
    </div>
</article>

<% if (author && (author.name || author.bio)) { %>
<section class="blog-post">
    <div class="blog-author">
        <% if (author.image) { %>
            <img src="<%= author.image %>" alt="<%= author.name %>" width="48" height="48" />
        <% } %>
        <div>
            <p class="blog-post-toc-label">Written by</p>
            <p class="blog-author-name"><% if (author.url) { %><a rel="author" href="<%= author.url %>"><%= author.name %></a><% } else { %><%= author.name %><% } %></p>
            <% if (author.role) { %><p class="blog-post-meta-muted"><%= author.role %></p><% } %>
            <% if (author.bio) { %><p class="blog-author-bio"><%= author.bio %></p><% } %>
        </div>
    </div>
</section>
<% } %>

<% if (typeof relatedPosts !== 'undefined' && relatedPosts && relatedPosts.length > 0) { %>
<section class="blog-post blog-related">
    <p class="blog-post-toc-label">More like this</p>
    <ul>
        <% relatedPosts.slice(0, 4).forEach(post => { %>
            <li>
                <a href="/blog/<%= post.slug %>"><%= post.title %></a>
                <time datetime="<%= post.date %>"><%= new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></time>
            </li>
        <% }); %>
    </ul>
</section>
<% } %>

<% if (Array.isArray(videoSchemaItems) && videoSchemaItems.length > 0) { %>
<script type="application/ld+json">
<%- JSON.stringify({
    "@context": "https://schema.org",
    "@graph": videoSchemaItems.map(video => ({
        "@type": "VideoObject",
        "name": video.name,
        "description": video.description,
        "thumbnailUrl": video.thumbnail_url_abs || video.thumbnail_url,
        "uploadDate": video.upload_date,
        ...(video.embed_url ? { "embedUrl": video.embed_url } : {}),
        ...(video.content_url ? { "contentUrl": video.content_url } : {}),
        ...(video.duration ? { "duration": video.duration } : {})
    }))
}, null, 2) %>
</script>
<% } %>
