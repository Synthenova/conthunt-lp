<%
  const home = typeof navHome !== 'undefined' && navHome;
  const active = typeof navActive === 'string' ? navActive : '';
%>
<nav class="fixed top-6 left-0 right-0 z-50 glass-nav h-[65px] flex items-center justify-center transition-all duration-300 mx-auto max-w-[95%] md:max-w-[1000px] site-nav">
    <div class="w-full max-w-6xl px-6 flex items-center justify-between relative">
        <div class="flex items-center">
            <a href="/" aria-label="ContHunt home">
                <img src="/public/logo-title-white.webp" alt="ContHunt Logo" width="462" height="78" class="h-6 w-auto" />
            </a>
        </div>
        <div class="hidden md:flex items-center gap-6 lg:gap-8 font-nav absolute left-1/2 -translate-x-1/2">
            <a href="/blog" class="text-xs font-bold <%= active === 'blog' ? 'text-white' : 'text-neutral-400' %> hover:text-white transition-colors">Blogs</a>
            <a href="<%= home ? '#mcp' : '/#mcp' %>" class="text-xs font-bold text-neutral-400 hover:text-white transition-colors">MCP</a>
            <a href="<%= home ? '#pricing' : '/#pricing' %>" class="text-xs font-bold text-neutral-400 hover:text-white transition-colors">Pricing</a>
        </div>
        <div class="flex items-center gap-2 font-nav">
            <details class="site-nav-menu md:hidden">
                <summary>Menu</summary>
                <div class="site-nav-dropdown">
                    <a href="/blog"<%= active === 'blog' ? ' class="is-active"' : '' %>>Blogs</a>
                    <a href="<%= home ? '#mcp' : '/#mcp' %>">MCP</a>
                    <a href="<%= home ? '#pricing' : '/#pricing' %>">Pricing</a>
                </div>
            </details>
            <a href="https://agent.conthunt.app" class="glass-button px-5 py-4 text-xs font-bold" style="margin-right: -15px;">
                <span>LOGIN</span>
                <span class="ml-1" aria-hidden="true">&rarr;</span>
            </a>
        </div>
    </div>
</nav>
<script>
(function () {
  document.querySelectorAll(".site-nav-menu").forEach(function (menu) {
    menu.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", function () {
        menu.removeAttribute("open");
      });
    });
  });
})();
</script>
