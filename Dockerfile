# One container, two apps behind nginx on :8080 (Cloud Run service conthunt-lp):
#   - the legacy static site (blog, docs, legal, feeds), generated by scripts/build-blog.js
#   - the Next.js marketing site in site/ (standalone server on 127.0.0.1:3000)
# nginx.conf keeps every legacy route and hands everything else to Next. See docker-entrypoint.sh.

# Stage 1: legacy blog/docs build (unchanged behaviour)
FROM node:20-alpine AS legacy
WORKDIR /app

# Copy package files first for caching
COPY package*.json ./
RUN npm install

# Only what the build script reads and serves (site/ has its own stage)
COPY scripts ./scripts
COPY content ./content
COPY skills ./skills
COPY assets ./assets
COPY public ./public
COPY privacy ./privacy
COPY terms ./terms
COPY rss.xml sitemap.xml robots.txt ./

# Generates blog/, docs/, .well-known/skills, rss.xml and sitemap.xml
RUN node scripts/build-blog.js

# Stage 2: Next.js site
FROM node:22-alpine AS site
RUN corepack enable
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY site/package.json site/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY site/ ./
# The legacy blog's own sitemap, merged into the site's /sitemap.xml at build time (site/src/app/sitemap.ts)
COPY --from=legacy /app/sitemap.xml ./legacy-sitemap.xml

# Public values (they end up in the client bundle and the rewrite table). Defaults are production.
ARG NEXT_PUBLIC_BACKEND_URL=https://conthunt-785174409154.us-central1.run.app
ARG NEXT_PUBLIC_APP_URL=https://agent.conthunt.app
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
RUN pnpm build

# Stage 3: runtime (node + nginx)
FROM node:22-alpine
RUN apk add --no-cache nginx \
    && mkdir -p /run/nginx /usr/share/nginx/html \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

# Legacy static output in the nginx root (the old index.html and sections/ are no longer served)
WORKDIR /usr/share/nginx/html
COPY --from=legacy /app/assets ./assets
COPY --from=legacy /app/public ./public
COPY --from=legacy /app/blog ./blog
COPY --from=legacy /app/privacy ./privacy
COPY --from=legacy /app/terms ./terms
COPY --from=legacy /app/rss.xml ./rss.xml
COPY --from=legacy /app/docs ./docs
COPY --from=legacy /app/.well-known ./.well-known

# Next standalone server
WORKDIR /app
COPY --from=site /app/.next/standalone ./
COPY --from=site /app/.next/static ./.next/static
COPY --from=site /app/public ./public
COPY --from=site /app/content ./content

COPY nginx.conf /etc/nginx/nginx.conf
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN sed -i 's/\r$//' /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh

ENV NODE_ENV=production
EXPOSE 8080
ENTRYPOINT ["/docker-entrypoint.sh"]
