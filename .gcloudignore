# What `gcloud builds submit` uploads to Cloud Build as the build source.
# At the root only the paths the Dockerfile COPYs are uploaded (scripts/build-blog.js reads nothing else).
# When the Dockerfile starts copying a new root path, add a `!/<path>` line for it. Until then the build
# fails with "<path>: not found". site/ is copied whole, so inside it only build output is left out.
# Without this file gcloud reads only the ROOT .gitignore (never site/.gitignore) and uploads site/.next.
# .dockerignore is deliberately uploaded: Cloud Build's docker step reads it from the build context.
# Check the result with: gcloud meta list-files-for-upload .
/*
!/Dockerfile
!/.dockerignore
!/docker-entrypoint.sh
!/nginx.conf
!/package.json
!/package-lock.json
!/rss.xml
!/sitemap.xml
!/robots.txt
!/scripts/
!/content/
!/skills/
!/assets/
!/public/
!/privacy/
!/terms/
!/site/
#!include:.gitignore

# Next app (site/): build output, installs, local env files and generated files
site/.next/
site/node_modules/
site/out/
site/.env
site/.env.*
!site/.env.example
site/*.tsbuildinfo
site/next-env.d.ts
site/legacy-sitemap.xml
site/.scratch/
site/.gitignore

# Documentation only (the Dockerfile never copies it)
site/docs/
